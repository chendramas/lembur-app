generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERVISOR
  KABAG
  PGA
  ADMIN
}

enum MingguKerja {
  LIMA_HARI
  ENAM_HARI
}

enum JenisHari {
  KERJA
  LIBUR
}

enum SPLStatus {
  DRAFT
  PENGAJUAN_KABAG
  PENGAJUAN_PGA
  APPROVED
  REJECTED_KABAG
  REJECTED_PGA
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  sectionId    String?  @map("section_id") @db.Uuid
  section      Section? @relation(fields: [sectionId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  kabagForSection  Section[]         @relation("KabagSection")
  splCreated       SPL[]             @relation("SPLCreator")
  approvalHistory  ApprovalHistory[] @relation("ApprovalUser")
  notifications    Notification[]

  @@map("users")
}

model Section {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama           String
  kepalaBagianId String?    @map("kepala_bagian_id") @db.Uuid
  kepalaBagian   User?      @relation("KabagSection", fields: [kepalaBagianId], references: [id])
  employees      Employee[]
  spls           SPL[]
  users          User[]
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("sections")
}

model Employee {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nama             String
  nip              String       @unique
  sectionId        String       @map("section_id") @db.Uuid
  section          Section      @relation(fields: [sectionId], references: [id])
  gajiPokok        Int          @map("gaji_pokok")
  jenisMingguKerja MingguKerja  @map("jenis_minggu_kerja") @default(LIMA_HARI)
  spls             SPL[]
  absensi          Absensi[]
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("employees")
}

model SPL {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  employee       Employee  @relation(fields: [employeeId], references: [id])
  tanggal        DateTime  @db.Date
  jenisHari      JenisHari @map("jenis_hari")
  jamMulai       String    @map("jam_mulai")
  jamSelesai     String    @map("jam_selesai")
  totalJam       Float     @map("total_jam")
  totalMenit     Int       @map("total_menit")
  upahLembur     Int       @map("upah_lembur")
  alasan         String
  status         SPLStatus @default(DRAFT)
  sectionId      String    @map("section_id") @db.Uuid
  section        Section   @relation(fields: [sectionId], references: [id])
  createdById    String    @map("created_by") @db.Uuid
  createdBy      User      @relation("SPLCreator", fields: [createdById], references: [id])
  catatanRevisi  String?   @map("catatan_revisi")
  isArchived     Boolean   @default(false) @map("is_archived")
  approvalHistory ApprovalHistory[]
  notifications  Notification[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("spl")
}

model ApprovalHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  splId      String   @map("spl_id") @db.Uuid
  spl        SPL      @relation(fields: [splId], references: [id])
  dariStatus SPLStatus @map("dari_status")
  keStatus   SPLStatus @map("ke_status")
  olehUserId String   @map("oleh_user_id") @db.Uuid
  olehUser   User     @relation("ApprovalUser", fields: [olehUserId], references: [id])
  catatan    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("approval_history")
}

model Absensi {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  tanggal    DateTime @db.Date
  jamMasuk   String   @map("jam_masuk")
  jamPulang  String   @map("jam_pulang")

  @@unique([employeeId, tanggal])
  @@map("absensi")
}

model HariLibur {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tanggal    DateTime @db.Date @unique
  keterangan String
  @@map("hari_libur")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  message   String
  splId     String?  @map("spl_id") @db.Uuid
  spl       SPL?     @relation(fields: [splId], references: [id])
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
